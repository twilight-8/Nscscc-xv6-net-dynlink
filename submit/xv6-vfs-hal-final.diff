+        ld.d $a5, $sp, 64
+        ld.d $a6, $sp, 72
+        ld.d $a7, $sp, 80
+        ld.d $t0, $sp, 88
+        ld.d $t1, $sp, 96
+        ld.d $t2, $sp, 104
+        ld.d $t3, $sp, 112
+        ld.d $t4, $sp, 120
+        ld.d $t5, $sp, 128
+        ld.d $t6, $sp, 136
+        ld.d $t7, $sp, 144
+        ld.d $t8, $sp, 152
+        ld.d $r21, $sp,160
+        ld.d $fp, $sp, 168
+        ld.d $s0, $sp, 176
+        ld.d $s1, $sp, 184
