diff --git a/./src/user/mount.c b/./src/user/mount.c
new file mode 100644
index 0000000..bbebd64
--- /dev/null
+++ b/./src/user/mount.c
@@ -0,0 +1,39 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+static int
+default_dev(char *fstype)
+{
+  if(strcmp(fstype, "xv6") == 0)
+    return 1;
+  if(strcmp(fstype, "ext2") == 0)
+    return 2;
+  if(strcmp(fstype, "fat32") == 0)
+    return 3;
+  return 0;
+}
+
+int
+main(int argc, char *argv[])
+{
+  int dev;
+
+  if(argc < 3 || argc > 4){
+    fprintf(2, "usage: mount fstype path [dev]\n");
+    exit(1);
+  }
+
+  if(argc == 4)
+    dev = atoi(argv[3]);
+  else
+    dev = default_dev(argv[1]);
+
+  if(mount(argv[1], argv[2], dev) < 0){
+    fprintf(2, "mount: failed\n");
+    exit(1);
+  }
+
+  printf("mount: %s on %s dev %d\n", argv[1], argv[2], dev);
+  exit(0);
+}
diff --git a/./src/user/test1.c b/./src/user/test1.c
new file mode 100644
index 0000000..7606762
--- /dev/null
+++ b/./src/user/test1.c
@@ -0,0 +1,61 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+#include "kernel/fcntl.h"
+
+#define LEN 1024
+
+static int
+copy_file(const char *src, const char *dst)
+{
+  int inf, outf, n;
+  char buf[LEN];
+
+  if((inf = open(src, O_RDONLY)) < 0){
+    fprintf(2, "test1: open %s failed\n", src);
+    return 1;
+  }
+
+  if((outf = open(dst, O_WRONLY | O_CREATE | O_TRUNC)) < 0){
+    fprintf(2, "test1: open %s failed\n", dst);
+    close(inf);
+    return 1;
+  }
+
+  while((n = read(inf, buf, sizeof(buf))) > 0){
+    if(write(outf, buf, n) != n){
+      fprintf(2, "test1: write failed\n");
+      close(inf);
+      close(outf);
+      return 1;
+    }
+  }
+
+  close(inf);
+  close(outf);
+  if(n < 0)
+    return 1;
+
+  printf("copy %s -> %s: ok\n", src, dst);
+  return 0;
+}
+
+int
+main(int argc, char *argv[])
+{
+  int failed = 0;
+
+  (void)argc;
+  (void)argv;
+
+  failed |= copy_file("/mnt/hello.c", "/hello.c");
+  failed |= copy_file("/mnt/hello.c", "/tests/hello.c");
+  failed |= copy_file("/hello.c", "/mnt/hello.c");
+  failed |= copy_file("/tests/hello.c", "/mnt/hello.c");
+
+  if(failed)
+    printf("test1: failed\n");
+  else
+    printf("test1: succeed\n");
+  exit(failed);
+}
