diff -ruN -d --strip-trailing-cr xv6-riscv-src/kernel/arch/loongarch/apic.c src/kernel/arch/loongarch/apic.c
--- xv6-riscv-src/kernel/arch/loongarch/apic.c
+++ src/kernel/arch/loongarch/apic.c
@@ -0,0 +1,38 @@
+#include "types.h"
+#include "param.h"
+#include "memlayout.h"
+#include "loongarch.h"
+#include "defs.h"
+
+//
+// the loongarch 7A1000 I/O Interrupt Controller Registers.
+//
+
+void
+apic_init(void)
+{
+  uint64 mask = (0x1UL << UART0_IRQ) | (0x1UL << VIRTIO0_IRQ);
+
+  *(volatile uint64*)(LS7A_INT_MASK_REG) = ~mask;
+
+  *(volatile uint64*)(LS7A_INT_EDGE_REG) = (0x1UL << UART0_IRQ);
+
+  *(volatile uint8*)(LS7A_INT_HTMSI_VEC_REG + UART0_IRQ) = UART0_IRQ;
+  *(volatile uint8*)(LS7A_INT_HTMSI_VEC_REG + VIRTIO0_IRQ) = VIRTIO0_IRQ;
+
+  *(volatile uint64*)(LS7A_INT_POL_REG) = 0x0UL;
+
+}
+
+void
+apicinit(void)
+{
+  apic_init();
+}
+
+// tell the apic we've served this IRQ.
+void
+apic_complete(uint64 irq)
+{
+  *(volatile uint64*)(LS7A_INT_CLEAR_REG) = (irq);
+}
diff -ruN -d --strip-trailing-cr xv6-riscv-src/kernel/arch/loongarch/asm.h src/kernel/arch/loongarch/asm.h
--- xv6-riscv-src/kernel/arch/loongarch/asm.h
+++ src/kernel/arch/loongarch/asm.h
@@ -0,0 +1,18 @@
+#define LOONGARCH_CSR_CRMD		    0x0	    /* Current mode info */
+#define LOONGARCH_CSR_CPUID		    0x20	/* CPU core id */
+
+#define LOONGARCH_CSR_SAVE0		    0x30    /* Kscratch registers */
+
+#define LOONGARCH_CSR_DMWIN0		0x180	/* 64 direct map win0: MEM & IF */
+#define LOONGARCH_CSR_DMWIN1		0x181	/* 64 direct map win1: MEM & IF */
+#define LOONGARCH_CSR_DMWIN2		0x182	/* 64 direct map win2: MEM */
+#define LOONGARCH_CSR_DMWIN3		0x183	/* 64 direct map win3: MEM */
+
+#define LOONGARCH_CSR_TLBEHI		0x11	/* TLB EntryHi */
+#define LOONGARCH_CSR_PGDL          0x19
+#define LOONGARCH_CSR_PGD           0x1b
+#define LOONGARCH_CSR_TLBRENTRY		0x88	/* TLB refill exception entry */
+#define LOONGARCH_CSR_TLBRBADV		0x89	/* TLB refill badvaddr */
+#define LOONGARCH_CSR_TLBRSAVE		0x8b	/* KScratch for TLB refill exception */
+
+/* Direct Map window 0/1 */
\ No newline at end of file
diff -ruN -d --strip-trailing-cr xv6-riscv-src/kernel/arch/loongarch/entry.S src/kernel/arch/loongarch/entry.S
--- xv6-riscv-src/kernel/arch/loongarch/entry.S
+++ src/kernel/arch/loongarch/entry.S
@@ -0,0 +1,38 @@
+	# qemu -kernel loads the kernel at 0x00000000
+        # and causes each CPU to jump there.
+        # kernel.ld causes the following code to
+        # be placed at 0x00000000.
+
+#include "asm.h"
+
+.section .text
+.global _entry
+_entry:
+        la.global   $t0, 0f
+        jirl        $zero, $t0, 0
+0:      li.d        $t0, 0x9000000000000011   # CA, PLV0, 0x9000 xxxx xxxx xxxx
+        csrwr       $t0, LOONGARCH_CSR_DMWIN0
+        li.d        $t0, 0x0000000000000000   
+        csrwr       $t0, LOONGARCH_CSR_DMWIN1
+        csrwr       $t0, LOONGARCH_CSR_DMWIN2
+        csrwr       $t0, LOONGARCH_CSR_DMWIN3
+        csrwr       $t0, LOONGARCH_CSR_TLBRENTRY	
+        li.w	    $t0, 0xb0		      # PLV=0, IE=0, PG=1
+	csrwr	    $t0, LOONGARCH_CSR_CRMD
+        invtlb      0x0,$zero,$zero
+	# set up a stack for C.
+        # stack0 is declared in start.c,
+        # with a 4096-byte stack per CPU.
+        # sp = stack0 + (hartid * 4096)
+     
+        la          $sp, stack0
+        li.d        $a0, 1024*4
+	csrrd       $a1, LOONGARCH_CSR_CPUID
+        addi.d      $tp, $a1, 0
+        addi.d      $a1, $a1, 1
+        mul.d       $a0, $a0, $a1
+        add.d       $sp, $sp, $a0
+	# jump to start() in start.c
+        bl          main
+spin:
+        b           spin
diff -ruN -d --strip-trailing-cr xv6-riscv-src/kernel/arch/loongarch/extioi.c src/kernel/arch/loongarch/extioi.c
--- xv6-riscv-src/kernel/arch/loongarch/extioi.c
+++ src/kernel/arch/loongarch/extioi.c
@@ -0,0 +1,35 @@
+#include "types.h"
+#include "param.h"
+#include "memlayout.h"
+#include "loongarch.h"
+#include "defs.h"
+
+void extioi_init(void)
+{
+    iocsr_writeq((0x1UL << UART0_IRQ) | (0x1UL << VIRTIO0_IRQ),
+                 LOONGARCH_IOCSR_EXTIOI_EN_BASE);
+
+    iocsr_writeq(0x01UL,LOONGARCH_IOCSR_EXTIOI_MAP_BASE);
+
+    iocsr_writeq(0x10000UL,LOONGARCH_IOCSR_EXTIOI_ROUTE_BASE);
+
+    iocsr_writeq(0x1,LOONGARCH_IOCSR_EXRIOI_NODETYPE_BASE);
+}
+
+void
+extioiinit(void)
+{
+    extioi_init();
+}
+
+// ask the extioi what interrupt we should serve.
+uint64
+extioi_claim(void)
+{
+    return iocsr_readq(LOONGARCH_IOCSR_EXTIOI_ISR_BASE);
+}
+
+void extioi_complete(uint64 irq)
+{
+    iocsr_writeq(irq, LOONGARCH_IOCSR_EXTIOI_ISR_BASE);
+}
diff -ruN -d --strip-trailing-cr xv6-riscv-src/kernel/arch/loongarch/hal.c src/kernel/arch/loongarch/hal.c
--- xv6-riscv-src/kernel/arch/loongarch/hal.c
+++ src/kernel/arch/loongarch/hal.c
@@ -0,0 +1,52 @@
+#include "types.h"
+#include "param.h"
+#include "memlayout.h"
+#include "riscv.h"
+#include "spinlock.h"
+#include "sleeplock.h"
+#include "defs.h"
+#include "fs.h"
+#include "buf.h"
+
+void
+hal_intr_init(void)
+{
+  apicinit();
+  extioiinit();
+}
+
+void
+hal_intr_inithart(void)
+{
+}
+
+int
+hal_irq_claim(void)
+{
+  // EXTIOI reports pending interrupts as a bitmask.
+  return extioi_claim();
+}
+
+void
+hal_irq_complete(int irq)
+{
+  // The virtio-pci interrupt is level-triggered and routed through
+  // the LS7A APIC, so it must be cleared there as well.  The UART is
+  // edge-triggered and needs no APIC clear.  Every interrupt is
+  // acknowledged at the EXTIOI.
+  if(irq & (1UL << VIRTIO0_IRQ))
+    apic_complete(1UL << VIRTIO0_IRQ);
+  extioi_complete(irq);
+}
+
+void
+hal_disk_init(void)
+{
+  virtio_disk_init();
+}
+
+void
+hal_disk_rw(struct buf *b, int write)
+{
+  virtio_disk_rw(b, write);
+}
diff -ruN -d --strip-trailing-cr xv6-riscv-src/kernel/arch/loongarch/kernel.ld src/kernel/arch/loongarch/kernel.ld
--- xv6-riscv-src/kernel/arch/loongarch/kernel.ld
+++ src/kernel/arch/loongarch/kernel.ld
@@ -0,0 +1,48 @@
+OUTPUT_ARCH( "loongarch" )
+ENTRY( _entry )
+
+SECTIONS
+{
+  . = 0x9000000000200000;
+
+  .text : {
+    *(.text .text.*)
+    . = ALIGN(0x1000);
+    _keentry = .;
+    *(k_eentry)
+    . = ALIGN(0x1000);
+    _ueentry = .;
+    *(u_eentry)
+    . = ALIGN(0x1000);
+    _tlbrentry = .;
+    *(tlbrentry)
+    . = ALIGN(0x1000);
+    _merrentry = .;
+    *(merrentry)
+    . = ALIGN(0x1000);
+    PROVIDE(etext = .);
+  }
+
+  .rodata : {
+    . = ALIGN(16);
+    *(.srodata .srodata.*)
+    . = ALIGN(16);
+    *(.rodata .rodata.*)
+  }
+
+  .data : {
+    . = ALIGN(16);
+    *(.sdata .sdata.*) 
+    . = ALIGN(16);
+    *(.data .data.*)
+  }
+
+  .bss : {
+    . = ALIGN(16);
+    *(.sbss .sbss.*) 
+    . = ALIGN(16);
+    *(.bss .bss.*)
+  }
+
+  PROVIDE(end = .);
+}
diff -ruN -d --strip-trailing-cr xv6-riscv-src/kernel/arch/loongarch/kernelvec.S src/kernel/arch/loongarch/kernelvec.S
