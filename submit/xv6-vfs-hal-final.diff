diff --git a/./src/kernel/arch/loongarch/kernel.ld b/./src/kernel/arch/loongarch/kernel.ld
new file mode 100644
index 0000000..0115d30
--- /dev/null
+++ b/./src/kernel/arch/loongarch/kernel.ld
@@ -0,0 +1,48 @@
+OUTPUT_ARCH( "loongarch" )
+ENTRY( _entry )
+
+SECTIONS
+{
+  . = 0x9000000000200000;
+
+  .text : {
+    *(.text .text.*)
+    . = ALIGN(0x1000);
+    _keentry = .;
+    *(k_eentry)
+    . = ALIGN(0x1000);
+    _ueentry = .;
+    *(u_eentry)
+    . = ALIGN(0x1000);
+    _tlbrentry = .;
+    *(tlbrentry)
+    . = ALIGN(0x1000);
+    _merrentry = .;
+    *(merrentry)
+    . = ALIGN(0x1000);
+    PROVIDE(etext = .);
+  }
+
+  .rodata : {
+    . = ALIGN(16);
+    *(.srodata .srodata.*)
+    . = ALIGN(16);
+    *(.rodata .rodata.*)
+  }
+
+  .data : {
+    . = ALIGN(16);
+    *(.sdata .sdata.*) 
+    . = ALIGN(16);
+    *(.data .data.*)
+  }
+
+  .bss : {
+    . = ALIGN(16);
+    *(.sbss .sbss.*) 
+    . = ALIGN(16);
+    *(.bss .bss.*)
+  }
+
+  PROVIDE(end = .);
+}
