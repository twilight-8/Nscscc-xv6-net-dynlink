diff -ruN -d --strip-trailing-cr xv6-riscv-src/user/umountstress.c src/user/umountstress.c
--- xv6-riscv-src/user/umountstress.c
+++ src/user/umountstress.c
@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: BSD-2-Clause
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "kernel/fcntl.h"
+#include "user/user.h"
+
+#define LOOPS 80
+
+static void
+lookup_worker(void)
+{
+  char buf[32];
+  int fd, i;
+
+  for(i = 0; i < LOOPS; i++){
+    fd = open("/mnt/hello.c", O_RDONLY);
+    if(fd >= 0){
+      if(read(fd, buf, sizeof(buf)) <= 0){
+        close(fd);
+        exit(1);
+      }
+      close(fd);
+    }
+  }
+  exit(0);
+}
+
+static void
+topology_worker(void)
+{
+  int i;
+
+  for(i = 0; i < LOOPS; i++){
+    if(umount("/mnt") == 0 && mount("ext2", "/mnt", 2) < 0)
+      exit(1);
+  }
+  exit(0);
+}
+
+int
+main(void)
+{
+  char buf[32];
+  int fd, i, status;
+
+  // An open inode must keep the mount busy.
+  fd = open("/mnt/hello.c", O_RDONLY);
+  if(fd < 0 || umount("/mnt") == 0){
+    printf("umountstress: FAIL open busy\n");
+    exit(1);
+  }
+  close(fd);
+
+  for(i = 0; i < 2; i++){
+    if(fork() == 0)
+      lookup_worker();
+    if(fork() == 0)
+      topology_worker();
+  }
+
+  for(i = 0; i < 4; i++){
+    if(wait(&status) < 0 || status != 0){
+      printf("umountstress: FAIL child\n");
+      exit(1);
+    }
+  }
+
+  fd = open("/mnt/hello.c", O_RDONLY);
+  if(fd < 0){
+    if(mount("ext2", "/mnt", 2) < 0)
+      goto fail;
+    fd = open("/mnt/hello.c", O_RDONLY);
+  }
+  if(fd < 0 || read(fd, buf, sizeof(buf)) <= 0)
+    goto fail;
+  close(fd);
+
+  printf("UMOUNT_STRESS_OK\n");
+  exit(0);
+
+fail:
+  if(fd >= 0)
+    close(fd);
+  printf("umountstress: FAIL final state\n");
+  exit(1);
+}
diff -ruN -d --strip-trailing-cr xv6-riscv-src/user/unlinkopen.c src/user/unlinkopen.c
--- xv6-riscv-src/user/unlinkopen.c
+++ src/user/unlinkopen.c
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: BSD-2-Clause
+// Regression test: an unlinked file that is still open must remain
+// readable until the last close (POSIX unlink semantics).
+// Usage: unlinkopen [path]   (default path: /mnt/uop.txt)
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+#include "kernel/fcntl.h"
+
+int
+main(int argc, char *argv[])
+{
+  char *path = "/mnt/uop.txt";
+  int wfd, rfd, n;
+  char buf[8];
+
+  if(argc > 1)
+    path = argv[1];
+
+  unlink(path);
+
+  if((wfd = open(path, O_WRONLY | O_CREATE)) < 0){
+    printf("unlinkopen: open-for-write %s failed\n", path);
+    exit(1);
+  }
+  if(write(wfd, "hello", 5) != 5){
+    printf("unlinkopen: write failed\n");
+    exit(1);
+  }
+
+  if((rfd = open(path, O_RDONLY)) < 0){
+    printf("unlinkopen: open-for-read %s failed\n", path);
+    exit(1);
+  }
+
+  if(unlink(path) < 0){
+    printf("unlinkopen: unlink %s failed\n", path);
+    exit(1);
+  }
+
+  // The data must still be readable through the open descriptor.
+  n = read(rfd, buf, 5);
+  if(n != 5 || memcmp(buf, "hello", 5) != 0){
+    printf("unlinkopen: FAIL (read %d bytes after unlink)\n", n);
+    exit(1);
+  }
+
+  close(wfd);
+  close(rfd);
+
+  // The last close frees the inode; the name must stay gone.
+  if(open(path, O_RDONLY) >= 0){
+    printf("unlinkopen: FAIL (file resurrected after close)\n");
+    exit(1);
+  }
+
+  printf("unlinkopen: ok\n");
+  exit(0);
+}
